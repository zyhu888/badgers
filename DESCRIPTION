Package: badgers
Title: Bayesian Adaptive Graph-Guided Errors-in-Variables Regression Solution
Version: 0.1.0
Authors@R: c(
    person("Zeyu", "Hu", email = "zeyu.hu8888@gmail.com", role = c("aut", "cre")),
    person("Kewen", "Qu", role = "aut"),
    person("Qi", "Long", role = "aut"),
    person("Jun", "Yan", email = "jun.yan@uconn.edu", role = "aut"),
    person("Wenrui", "Li", email = "wenrui.li@uconn.edu", role = "aut")
